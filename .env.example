APP_ENV=local
APP_NAME=千人千案 Agent Harness
API_PREFIX=/api/v1
DATA_ROOT=D:/CodexTemp/qianrenqianan/docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/learning_agent
REDIS_URL=redis://localhost:16380/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=learning-agent
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
PII_HMAC_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-a-fernet-key
SMS_PROVIDER=fixed
FIXED_SMS_CODE=246810
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLUS_MODEL=qwen3.7-plus-2026-05-26
QWEN_FLASH_MODEL=qwen3.7-flash-2026-07-15
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
USE_FAKE_MODEL=true
RESOURCE_STORAGE_ROOT=D:/CodexTemp/qianrenqianan/resources
RESOURCE_MAX_DOCUMENT_BYTES=104857600
RESOURCE_MAX_IMAGE_BYTES=10485760
RESOURCE_MAX_IMAGE_COUNT=50
PLANNING_TIMEZONE=Asia/Shanghai
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
ALLOWED_ORIGINS=[]
